{
  "name": "blkout-toc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BLKOUT: Tactical Operations Center — unofficial fan companion app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run check && npm run test && npm run build",
    "schema": "node --experimental-strip-types --no-warnings scripts/emit-schema.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
